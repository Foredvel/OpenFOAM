FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      N2;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0.724664;

boundaryField
{
    left
    {
        type            fixedValue;
        value           uniform 0.724664;
    }
    right
    {
        type            zeroGradient;
    }
    sides
    {
        type            empty;
    }
    frontAndBack
    {
        type            empty;
    }
}

